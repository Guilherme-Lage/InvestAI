# Copie este arquivo para .env (na mesma pasta) e preencha os valores.
# O .env fica fora do Git: nunca publique chaves no repositório.

# Chave que assina os tokens JWT do login. Use um valor longo e aleatório, por exemplo:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Endereço do webhook do agente de IA no n8n (Produção). Sem ele, o chat responde
# que a IA não está configurada e o resto do app funciona normalmente.
N8N_WEBHOOK_URL=http://localhost:5678/webhook/COLE-AQUI-O-ID-DO-WEBHOOK

# Opcional: chave enviada no cabeçalho X-API-Key, se o webhook do n8n exigir.
N8N_API_KEY=

# 127.0.0.1 = só este computador. 0.0.0.0 = aceita o celular na mesma rede Wi-Fi
# (nesse caso o modo debug é desligado sozinho).
INVESTAI_HOST=127.0.0.1
